<Project Sdk="WixToolset.Sdk/5.0.2">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>InfluxDBStudio-$(Version)-Setup-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <MsiPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\InfluxDBStudio-$(Version)-win-x64.msi</MsiPath>
    <IconPath>$(MSBuildThisFileDirectory)..\..\src\CymaticLabs.InfluxDB.Studio\Resources\AppIcon.ico</IconPath>
    <LogoPath>$(MSBuildThisFileDirectory)..\..\src\CymaticLabs.InfluxDB.Studio\Resources\influxdb-logo.png</LogoPath>
    <DefineConstants>ProductVersion=$(Version);MsiPath=$(MsiPath);IconPath=$(IconPath);LogoPath=$(LogoPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <ProjectReference Include="..\InfluxDBStudio.Setup\InfluxDBStudio.Setup.wixproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
