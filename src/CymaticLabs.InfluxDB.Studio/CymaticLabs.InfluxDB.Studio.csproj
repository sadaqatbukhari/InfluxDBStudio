<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CymaticLabs.InfluxDB.Studio</RootNamespace>
    <AssemblyName>InfluxDBStudio</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>InfluxDB Studio</Title>
    <Description>Visual IDE for managing InfluxDB</Description>
    <Company>Cymatic Labs</Company>
    <Product>InfluxDB Studio</Product>
    <Copyright>Copyright © Michael Everett/Cymatic Labs 2017</Copyright>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
    <SyncfusionVersion>34.2.3</SyncfusionVersion>
    <SyncfusionLicenseKey>$(SYNCFUSION_LICENSE_KEY)</SyncfusionLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="InfluxDB.Client" Version="5.1.0" />
    <PackageReference Include="InfluxDB3.Client" Version="1.9.0" />
    <PackageReference Include="Syncfusion.Edit.Windows" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Office2019Theme.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.SfDataGrid.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Tools.Windows" Version="$(SyncfusionVersion)" />
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(SyncfusionLicenseKey)' != ''">
    <AssemblyMetadata Include="SyncfusionLicenseKey" Value="$(SyncfusionLicenseKey)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\InfluxQL.xml" />
  </ItemGroup>
</Project>
